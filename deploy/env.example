# ---------------------------------------------------------------------------
# PIX Recovery — environment template.
#
# Copy it, fill in the real values, and use it as ENV_SRC for
# deploy/setup_server.sh, which installs it as /etc/pix-recovery/env (0600
# root:pixapp) and APPENDS the generated DATABASE_URL to it.
#
#   scp -i ~/.ssh/id_ed25519_pix deploy/env.example root@179.199.147.30:/root/pix-recovery.env
#   # edit it on the server, then run setup_server.sh
#
# Locally the same keys live in secrets.env (never committed, never printed).
# The app reads configuration from the ENVIRONMENT ONLY — no .env file is read
# implicitly — so on Windows export the values before `uv run`.
#
# Format: KEY=value, one per line, no quotes, no spaces around `=`
# (systemd EnvironmentFile syntax — a quoted value keeps its quotes).
# ---------------------------------------------------------------------------

# --- general ---------------------------------------------------------------
APP_ENV=prod
LOG_LEVEL=INFO
# DATABASE_URL is written by deploy/setup_server.sh with the generated password.
# Leave it out here; locally the default is sqlite:///./dev.db.
# DATABASE_URL=postgresql+psycopg://pixrecovery:...@127.0.0.1:5432/pixrecovery
API_DOMAIN=api.jornadaanjo.cloud
# PUBLIC_BASE_URL=https://api.jornadaanjo.cloud
BUSINESS_TZ=America/Sao_Paulo

# --- Kirvano ---------------------------------------------------------------
# The token typed in the Kirvano webhook form (Integrações > Webhooks).
KIRVANO_WEBHOOK_TOKEN=troque-por-um-token-aleatorio
# `log` first: accept everything and record only header NAMES, so the first real
# delivery reveals how Kirvano transports the token. Flip to `enforce` after that.
KIRVANO_TOKEN_MODE=log
KIRVANO_TZ=America/Sao_Paulo
# Offer/checkout link, used on the PIX page when the code has expired.
KIRVANO_CHECKOUT_URL=https://pay.kirvano.com/00000000-0000-0000-0000-000000000000
# Only a fallback for payloads without payment.expires_at (his checkout: 24 h).
KIRVANO_PIX_EXPIRY_MINUTES=1440
AUTH_DEBUG_MAX_ROWS=50

# --- Meta / WhatsApp Cloud API ---------------------------------------------
# Permanent system-user token (never expires) — rotate per README.
META_ACCESS_TOKEN=
# App secret: when unset, webhook signatures are NOT verified (a warning is logged).
META_APP_SECRET=
# Free text you invent; must match the value typed in the Meta webhook form.
META_VERIFY_TOKEN=troque-por-outro-token-aleatorio
META_PHONE_NUMBER_ID=1347340825121720
META_WABA_ID=958025707339789
META_BUSINESS_ID=
META_APP_ID=
META_GRAPH_VERSION=v23.0
META_GRAPH_BASE_URL=https://graph.facebook.com
HTTP_TIMEOUT_SECONDS=15

# --- Panel (HTTP Basic) ----------------------------------------------------
PANEL_USER=admin
# The panel REFUSES to serve (503) while this is empty. Use a long random value.
PANEL_PASSWORD=

# --- Reminder defaults (the panel overrides these in the DB) ---------------
REMINDER_DELAY_MINUTES=10
DAILY_RECIPIENT_LIMIT=250
QUIET_START=22:00
QUIET_END=08:00
TEMPLATE_NAME=pix_pendente_v2
TEMPLATE_LANGUAGE=pt_BR
# 0-based position of the URL button in the template; -1 = template has no URL button.
TEMPLATE_URL_BUTTON_INDEX=1
TEMPLATE_PARAMS=first_name,sale_id,amount,expiry

# --- Worker ----------------------------------------------------------------
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=3
WORKER_TOKEN_PAUSE_MINUTES=10

# ---------------------------------------------------------------------------
# Deploy-only keys. The app ignores them (Settings has extra="ignore"), so one
# file can feed both the application and deploy/deploy.sh + deploy/check.sh.
# ---------------------------------------------------------------------------
VPS_HOST=179.199.147.30
VPS_USER=root
SSH_KEY_PATH=~/.ssh/id_ed25519_pix
LETSENCRYPT_EMAIL=jornadacommeuanjo@outlook.com
APP_DIR=/opt/pix-recovery

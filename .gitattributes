# The deploy scripts run on Ubuntu. If git checks them out with CRLF the
# shebang line becomes "#!/usr/bin/env bash\r" and the server answers
# "bad interpreter: No such file or directory". Force LF on everything
# that is executed rather than read.
*.sh   text eol=lf
*.py   text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer   text eol=lf
* text=auto
